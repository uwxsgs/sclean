def clean_pacman(dry_run):
    """Remove corrupted/partial pacman downloads."""
    pkg_dir = Path("/var/cache/pacman/pkg")
    if not pkg_dir.is_dir():
        return _clean()
    files = list(pkg_dir.glob("download-*")) + list(pkg_dir.glob("*.part"))
    if not files:
        return _clean()
    count = len(files)
    if dry_run:
        return _scanned(f"would remove {count} partial downloads")
    before = _dir_size_kb(pkg_dir)
    _run(["sudo", "rm", "-rf"] + [str(f) for f in files])
    after = _dir_size_kb(pkg_dir)
    freed = max(0, before - after)
    return _freed(freed) if freed > 0 else _clean(f"removed {count} files")


def clean_orphans(dry_run):
    """Remove orphaned packages (unneeded dependencies)."""
    r = _run(["pacman", "-Qdtq"])
    orphans = r.stdout.strip().split("\n") if r.returncode == 0 and r.stdout.strip() else []
    if not orphans:
        return _clean("no orphans found")
    count = len(orphans)
    if dry_run:
        return _scanned(f"would remove {count} orphans")
    # Re-check right before removing (list may change)
    r = _run(["pacman", "-Qdtq"])
    current = r.stdout.strip().split("\n") if r.returncode == 0 and r.stdout.strip() else []
    if not current:
        return _clean("orphans already resolved")
    if _has("paru"):
        pkg_cmd = ["paru", "-Rns", "--noconfirm"]
    elif _has("yay"):
        pkg_cmd = ["yay", "-Rns", "--noconfirm"]
    else:
        pkg_cmd = ["sudo", "pacman", "-Rns", "--noconfirm"]
    _run(pkg_cmd + current, timeout=120)
    return _result("freed", f"removed {count} orphans")


def clean_deep_orphans(dry_run):
    """Remove deep orphans including optional deps."""
    r = _run(["pacman", "-Qdttq"])
    orphans = r.stdout.strip().split("\n") if r.returncode == 0 and r.stdout.strip() else []
    if not orphans:
        return _clean("no deep orphans")
