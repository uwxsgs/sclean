_CORE_TEMPFILE = None

def _extract_core():
    """Extract the embedded sclean bash script to a temp file."""
    global _CORE_TEMPFILE
    if _CORE_TEMPFILE and os.path.isfile(_CORE_TEMPFILE):
        return _CORE_TEMPFILE
    data = zlib.decompress(base64.b85decode(_CORE_B85))
    fd, path = tempfile.mkstemp(prefix="sclean-core-", suffix=".sh")
    os.write(fd, data)
    os.close(fd)
    os.chmod(path, 0o755)
    _CORE_TEMPFILE = path
    atexit.register(lambda: os.unlink(path) if os.path.exists(path) else None)
    return path

def _find_sclean_core():
    """Find sclean-core: prefer system-installed, fall back to embedded."""
    for p in [
        os.path.expanduser("~/.local/bin/sclean-core"),
        shutil.which("sclean-core") or "",
    ]:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    # Fall back to embedded copy
    return _extract_core()

