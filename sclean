    if total_kb == 0:
        return _clean("no shader cache")
    if dry_run:
        return _scanned(f"would clear shader cache ({human_kb(total_kb)})")
    for d in existing:
        _rm_contents(d)
    return _freed(total_kb)


def clean_dev_caches(dry_run):
    """Clean developer tool caches (npm, pip, go, cargo, etc.)."""
    home = Path.home()
    # Determine Go module cache path
    go_mod = home / "go" / "pkg" / "mod"
    if _has("go"):
        r = _run(["go", "env", "GOMODCACHE"])
        if r.returncode == 0 and r.stdout.strip():
            go_mod = Path(r.stdout.strip())
    dirs = [
        ("npm", home / ".npm"),
        ("pip", home / ".cache" / "pip"),
        ("Go modules", go_mod),
        ("Cargo registry", home / ".cargo" / "registry"),
        ("Gradle", home / ".gradle" / "caches"),
        ("Maven", home / ".m2" / "repository"),
        ("Composer", home / ".cache" / "composer"),
        ("Gem", home / ".local" / "share" / "gem"),
        ("Yarn", home / ".cache" / "yarn"),
        ("Yarn v2+", home / ".yarn" / "cache"),
        ("pnpm", home / ".local" / "share" / "pnpm" / "store"),
        ("Playwright", home / ".cache" / "ms-playwright"),
        ("Playwright Go", home / ".cache" / "ms-playwright-go"),
    ]
    total_kb = 0
    found = []
    for label, d in dirs:
        if d.is_dir():
            s = _dir_size_kb(d)
            if s > 0:
                total_kb += s
                found.append((label, d))
    if not found:
        return _clean("no dev caches")
    if dry_run:
        return _scanned(f"would clean dev caches ({human_kb(total_kb)})")
    # Tool-specific cleaning
    if _has("npm"):
        _run(["npm", "cache", "clean", "--force"], timeout=30)
    if _has("pip") or _has("pip3"):
        _run(["pip", "cache", "purge"], timeout=30)
    if _has("go"):
        _run(["go", "clean", "-modcache"], timeout=30)
    if _has("cargo"):
        r = _run(["cargo", "cache", "-a"], timeout=30)
        if r.returncode != 0:
            cache = home / ".cargo" / "registry" / "cache"
            if cache.is_dir():
                _rm_contents(cache)
    if _has("composer"):
        _run(["composer", "clear-cache"], timeout=30)
    # Direct cleanup for everything else
    for path in [
        home / ".npm" / "_cacache", home / ".cache" / "pip",
        home / ".gradle" / "caches", home / ".m2" / "repository",
        home / ".cache" / "yarn", home / ".yarn" / "cache",
        home / ".local" / "share" / "pnpm" / "store",
        home / ".cache" / "ms-playwright", home / ".cache" / "ms-playwright-go",
    ]:
        if path.is_dir():
            _rm_contents(path)
    return _freed(total_kb)


def clean_old_logs(dry_run):
    """Remove rotated/old log files in /var/log."""
    patterns = ["-name", "*.old", "-o", "-name", "*.gz", "-o", "-name", "*.xz",
                "-o", "-name", "*.bz2", "-o", "-name", "*.[0-9]", "-o", "-name", "*.[0-9].gz"]
    files = _find("/var/log", "-type", "f", "(", *patterns, ")")
    if not files:
        return _clean("no old logs")
    count = len(files)
    if dry_run:
        return _scanned(f"would remove {count} old log files")
    before = _dir_size_kb("/var/log")
    _run(["sudo", "find", "/var/log", "-type", "f", "(", *patterns, ")", "-delete"], timeout=30)
    after = _dir_size_kb("/var/log")
    freed = max(0, before - after)
    return _freed(freed) if freed > 0 else _result("freed", f"removed {count} logs")


def clean_systemd_failed(dry_run):
    """Reset failed systemd units."""
    r = _run(["systemctl", "--failed", "--plain", "--no-legend"])
    if not r.stdout.strip():
        return _clean("no failed units")
    count = len(r.stdout.strip().split("\n"))
    if dry_run:
        return _scanned(f"would reset {count} failed units")
    _run(["sudo", "systemctl", "reset-failed"])
    return _result("freed", f"reset {count} failed units")


def clean_service_leftovers(dry_run):
    """Clean broken systemd links and not-found units."""
    # System not-found units
    r = _run(["systemctl", "list-units", "--all", "--plain", "--no-legend"])
    sys_notfound = [l.split()[0] for l in r.stdout.split("\n")
                    if len(l.split()) >= 2 and l.split()[1] == "not-found"]
    # User not-found units
    r = _run(["systemctl", "--user", "list-units", "--all", "--plain", "--no-legend"])
    user_notfound = [l.split()[0] for l in r.stdout.split("\n")
                     if len(l.split()) >= 2 and l.split()[1] == "not-found"]
    # Broken symlinks in systemd dirs
    sys_broken = []
    for d in ["/etc/systemd/system", "/etc/systemd/user"]:
        if Path(d).exists():
            sys_broken += _find(d, "-xtype", "l")
    user_sd = Path.home() / ".config" / "systemd" / "user"
    user_broken = _find(str(user_sd), "-xtype", "l") if user_sd.exists() else []

    total = len(sys_notfound) + len(user_notfound) + len(sys_broken) + len(user_broken)
    if total == 0:
        return _clean("no leftover systemd entries")
    if dry_run:
        return _scanned(f"would clean {total} systemd leftovers")
    for link in sys_broken:
        _run(["sudo", "rm", "-f", link])
    for link in user_broken:
        try:
            os.unlink(link)
        except OSError:
            pass
    for unit in sys_notfound:
        _run(["sudo", "systemctl", "disable", unit])
        _run(["sudo", "systemctl", "reset-failed", unit])
    for unit in user_notfound:
        _run(["systemctl", "--user", "disable", unit])
        _run(["systemctl", "--user", "reset-failed", unit])
    _run(["sudo", "systemctl", "daemon-reload"])
    _run(["systemctl", "--user", "daemon-reload"])
    return _result("freed", f"cleaned {total} leftovers")


def clean_browser_cache(dry_run):
    """Clean browser cache data."""
    home = Path.home()
    browsers = [
        ("Chrome",   home / ".cache" / "google-chrome"),
        ("Chromium", home / ".cache" / "chromium"),
        ("Firefox",  home / ".cache" / "mozilla" / "firefox"),
        ("Brave",    home / ".cache" / "BraveSoftware"),
