clean_broken_symlinks() {
    is_category_enabled "broken-symlinks" || return 0
    step_header "Finding broken symbolic links in home directory"

    # Filter out runtime/expected broken symlinks (Chrome Singleton files, snap, etc.)
    local broken
    broken=$(find "$HOME" -maxdepth 4 -xtype l 2>/dev/null | grep -v \
        -e 'SingletonLock' \
        -e 'SingletonCookie' \
        -e 'SingletonSocket' \
        -e '.snap/' \
        -e '/run/' \
        -e '/proc/' \
        -e '.steam/' \
    )

    if [[ -z "$broken" ]]; then
        echo -e "   ${DIM}No broken symlinks found.${RESET}"
        return
    fi

    local count
    count=$(echo "$broken" | wc -l)
    echo "   Found $count broken symlinks:"
    echo "$broken" | head -20 | sed 's/^/     /'
    (( count > 20 )) && echo "     ... and $((count - 20)) more"

    if dry_run_msg "Would remove $count broken symlinks"; then
        return
    fi

    if confirm "Remove $count broken symlinks?"; then
        while IFS= read -r link; do
            rm -f "$link" 2>/dev/null
        done <<< "$broken"
        echo -e "   ${GREEN}✓ Done.${RESET}"
