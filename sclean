clean_stale_processes() {
    is_category_enabled "stale-procs" || return 0
    step_header "Terminating stale user processes (deleted executables)"

    local uid
    uid=$(id -u)

    local stale_pids=()
    local stale_meta=()
    local total_rss=0

    local proc pid proc_uid target comm rss
    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue
        [[ -r "$proc/status" && -L "$proc/exe" ]] || continue

        proc_uid=$(awk '/^Uid:/ {print $2}' "$proc/status" 2>/dev/null)
        [[ "$proc_uid" == "$uid" ]] || continue

        target=$(readlink "$proc/exe" 2>/dev/null || true)
        [[ "$target" == *"(deleted)"* ]] || continue

        comm=$(awk '/^Name:/ {print $2}' "$proc/status" 2>/dev/null)
        rss=$(awk '/^VmRSS:/ {print $2}' "$proc/status" 2>/dev/null)
        rss=${rss:-0}

        stale_pids+=("$pid")
        stale_meta+=("$pid:$comm:$rss")
        total_rss=$((total_rss + rss))
    done

    local count=${#stale_pids[@]}
    if (( count == 0 )); then
        echo -e "   ${DIM}No stale user processes found.${RESET}"
        return
    fi

    echo "   Found $count stale user processes (RSS: ~$(human_size "$total_rss"))"
    local shown=0
    local item
    for item in "${stale_meta[@]}"; do
        local p c r
        IFS=':' read -r p c r <<< "$item"
        echo "     PID $p  $c  RSS $(human_size "$r")"
        shown=$((shown + 1))
        (( shown >= 15 )) && break
    done
    (( count > 15 )) && echo "     ... and $((count - 15)) more"

    if dry_run_msg "Would terminate $count stale user processes"; then
        return
    fi

    if confirm "Terminate these stale processes?"; then
        kill -TERM "${stale_pids[@]}" 2>/dev/null || true
        sleep 1

        local still_alive=()
        for pid in "${stale_pids[@]}"; do
            kill -0 "$pid" 2>/dev/null && still_alive+=("$pid")
        done

        if (( ${#still_alive[@]} > 0 )); then
            kill -KILL "${still_alive[@]}" 2>/dev/null || true
            sleep 1
        fi

        local remaining=0
        for pid in "${stale_pids[@]}"; do
            kill -0 "$pid" 2>/dev/null && remaining=$((remaining + 1))
        done
        local terminated=$((count - remaining))

        echo "   Terminated $terminated/$count stale processes."
        (( remaining > 0 )) && echo -e "   ${DIM}$remaining process(es) could not be terminated.${RESET}"
        echo -e "   ${GREEN}✓ Done.${RESET}"
        log "Stale process cleanup: terminated $terminated of $count"
    else
        echo -e "   ${DIM}Skipped.${RESET}"
    fi
}

# ─── Summary Report ─────────────────────────────────────────────────

print_summary() {
    local after_disk
    after_disk=$(df --output=avail / 2>/dev/null | tail -1 | tr -d ' ')

    echo ""
    echo -e "${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}║              🧹 Cleanup Summary Report                  ║${RESET}"
    echo -e "${BOLD}╠══════════════════════════════════════════════════════════╣${RESET}"

    if (( TOTAL_FREED > 0 )); then
        local freed_human
        freed_human=$(human_size $TOTAL_FREED)
