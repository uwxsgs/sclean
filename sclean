def clean_locale_purge(dry_run):
    """Remove unused locale/translation files."""
    locale_dir = Path("/usr/share/locale")
    if not locale_dir.is_dir():
        return _clean("no locale dir")
    current_lang = os.environ.get("LANG", "en_US.UTF-8").split(".")[0].split("_")[0]
    keep = {"en", current_lang, "locale.alias"}
    removable = [d for d in locale_dir.iterdir()
                 if d.is_dir() and not any(d.name.startswith(k) for k in keep)]
    if not removable:
        return _clean("no removable locales")
    before = _dir_size_kb(locale_dir)
    if dry_run:
        return _scanned(f"would remove {len(removable)} locale dirs")
    for d in removable:
        _run(["sudo", "rm", "-rf", str(d)])
    after = _dir_size_kb(locale_dir)
    freed = max(0, before - after)
    return _freed(freed) if freed > 0 else _result("freed", f"removed {len(removable)} locales")


def clean_docker(dry_run):
    """Prune Docker resources."""
    if not _has("docker"):
        return _skipped()
    if _run(["docker", "info"], timeout=10).returncode != 0:
        return _skipped("daemon not running")
    c = _run(["docker", "ps", "-a", "--filter", "status=exited", "-q"]).stdout.strip()
    i = _run(["docker", "images", "--filter", "dangling=true", "-q"]).stdout.strip()
    v = _run(["docker", "volume", "ls", "--filter", "dangling=true", "-q"]).stdout.strip()
    total = (len(c.split("\n")) if c else 0) + (len(i.split("\n")) if i else 0) + (len(v.split("\n")) if v else 0)
    if total == 0:
        return _clean("nothing to prune")
    if dry_run:
        return _scanned(f"would prune docker resources")
    for cmd in [["docker", "container", "prune", "-f"],
                ["docker", "image", "prune", "-f"],
                ["docker", "volume", "prune", "-f"],
                ["docker", "builder", "prune", "-f"]]:
        _run(cmd, timeout=60)
    return _result("freed", "pruned docker resources")


def clean_snap(dry_run):
    """Remove old snap revisions."""
    if not _has("snap"):
        return _skipped()
    r = _run(["snap", "list", "--all"])
    if r.returncode != 0:
        return _skipped()
    old_snaps = []
    for line in r.stdout.split("\n"):
        if "disabled" in line:
            parts = line.split()
            if len(parts) >= 3:
                old_snaps.append((parts[0], parts[2]))
    if not old_snaps:
        return _clean("no old snap revisions")
    if dry_run:
        return _scanned(f"would remove {len(old_snaps)} old snap revisions")
    for name, rev in old_snaps:
        _run(["sudo", "snap", "remove", name, f"--revision={rev}"], timeout=30)
    return _result("freed", f"removed {len(old_snaps)} snap revisions")


def clean_kde_cache(dry_run):
