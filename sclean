    else
        echo -e "${BOLD}║${RESET}  ${DIM}No significant space was freed.${RESET}"
    fi

    echo -e "${BOLD}║${RESET}  Disk available:  $(df -h --output=avail / 2>/dev/null | tail -1 | tr -d ' ')"
    echo -e "${BOLD}║${RESET}  Disk used:       $(df -h --output=pcent / 2>/dev/null | tail -1 | tr -d ' ')"

    if $DRY_RUN; then
        echo -e "${BOLD}║${RESET}"
        echo -e "${BOLD}║${RESET}  ${MAGENTA}This was a DRY RUN — nothing was actually deleted.${RESET}"
        echo -e "${BOLD}║${RESET}  ${MAGENTA}Run without -n to perform actual cleanup.${RESET}"
    fi

    echo -e "${BOLD}║${RESET}"
    echo -e "${BOLD}║${RESET}  Log: ${DIM}$LOG_FILE${RESET}"
    echo -e "${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}"
    echo ""

    log "=== SUMMARY: Freed approximately $(human_size $TOTAL_FREED) ==="
}

# ─── Argument Parsing ────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -y|--yes)
            AUTO_YES=true
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        --only)
            IFS=',' read -ra ENABLED_CATEGORIES <<< "$2"
            shift 2
            ;;
        --skip)
            IFS=',' read -ra SKIPPED_CATEGORIES <<< "$2"
            shift 2
            ;;
        *)
            echo -e "${RED}Unknown option: $1${RESET}"
            echo "Use --help for usage information."
            exit 1
            ;;
    esac
done

# ─── Count enabled steps ─────────────────────────────────────────────

for cat in "${ALL_CATEGORIES[@]}" "${OPTIN_CATEGORIES[@]}"; do
    is_category_enabled "$cat" && TOTAL_STEPS=$((TOTAL_STEPS + 1))
done

# ─── Main ─────────────────────────────────────────────────────────────

echo -e "${BLUE}"
echo "╔══════════════════════════════════════════════════════════╗"
echo "║        sclean — Deep System Cleanup v2.2           ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo -e "${RESET}"

if $DRY_RUN; then
    echo -e "${MAGENTA}🔍 DRY RUN MODE — No files will be deleted.${RESET}"
fi

# Show disk usage before
echo -e "${DIM}Disk usage before cleanup:${RESET}"
df -h / --output=size,used,avail,pcent | head -2
echo ""

log "=== sclean v2.2 started ==="
log "Dry run: $DRY_RUN | Auto yes: $AUTO_YES"

# Run all enabled cleanup functions
clean_pacman_downloads
clean_orphans
clean_deep_orphans
clean_package_cache
clean_journal
clean_flatpak
clean_flatpak_data
clean_flatpak_cache
clean_temp_files
clean_user_cache
clean_coredumps
clean_thumbnails
clean_trash
clean_broken_symlinks
clean_crash_reports
clean_mesa_shader
clean_dev_caches
clean_old_logs
check_pacnew
clean_systemd_failed
clean_service_leftovers
clean_browser_cache
clean_ram_cache
clean_stale_processes

# Final summary
print_summary

echo -e "${GREEN}✨ System cleanup complete!${RESET}"
