    return _result("freed", "removed stale db.lck")


def clean_baloo_index(dry_run):
    """Clean KDE Baloo file search index."""
    baloo_dir = Path.home() / ".local" / "share" / "baloo"
    if not baloo_dir.is_dir():
        return _clean("no Baloo index")
    total_kb = _dir_size_kb(baloo_dir)
    if total_kb < 10:  # less than 10KB, not worth cleaning
        return _clean("Baloo index is small")
    if dry_run:
        return _scanned(f"would rebuild Baloo index ({human_kb(total_kb)})")
    # balooctl6 (Plasma 6) or balooctl (Plasma 5)
    ctl = "balooctl6" if _has("balooctl6") else "balooctl" if _has("balooctl") else None
    if ctl:
        _run([ctl, "purge"], timeout=30)
    else:
        _rm_contents(baloo_dir)
    after = _dir_size_kb(baloo_dir)
    freed = max(0, total_kb - after)
    return _freed(freed) if freed > 0 else _result("freed", "purged Baloo index")


def clean_man_cache(dry_run):
    """Clean man page cache."""
    man_dir = Path("/var/cache/man")
    if not man_dir.is_dir():
        return _clean("no man cache")
    total_kb = _dir_size_kb(man_dir)
    if total_kb < 1:
        return _clean("man cache empty")
    if dry_run:
        return _scanned(f"would clean man cache ({human_kb(total_kb)})")
    _run(["sudo", "find", str(man_dir), "-type", "f", "-name", "*.gz", "-delete"], timeout=30)
    _run(["sudo", "find", str(man_dir), "-type", "d", "-empty", "-delete"], timeout=15)
    after = _dir_size_kb(man_dir)
    freed = max(0, total_kb - after)
    return _freed(freed) if freed > 0 else _clean()


def clean_font_cache(dry_run):
    """Clean fontconfig cache and rebuild."""
    fc_dir = Path.home() / ".cache" / "fontconfig"
    if not fc_dir.is_dir():
        return _clean("no font cache")
