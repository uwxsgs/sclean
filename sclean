def clean_pacman_db_lock(dry_run):
    """Remove stale pacman database lock file."""
    lock = Path("/var/lib/pacman/db.lck")
    if not lock.exists():
        return _clean("no stale lock")
    # Check if pacman is actually running
    r = _run(["pgrep", "-x", "pacman"])
    if r.returncode == 0 and r.stdout.strip():
        return _clean("pacman is running, lock is valid")
    if dry_run:
        return _scanned("would remove stale pacman db.lck")
