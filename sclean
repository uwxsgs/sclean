clean_locale_purge() {
    is_category_enabled "locale-purge" || return 0
    step_header "Cleaning unused locale/translation files"

    local current_lang
    current_lang=$(echo "${LANG:-en_US.UTF-8}" | cut -d. -f1 | cut -d_ -f1)
    local keep_locales=("en" "$current_lang" "locale.alias")

    local before
    before=$(get_dir_size /usr/share/locale 2>/dev/null || echo 0)

    # Count locale dirs that aren't in our keep list
    local removable=0
    while IFS= read -r dir; do
        local base
        base=$(basename "$dir")
        local keep=false
        for k in "${keep_locales[@]}"; do
            [[ "$base" == "$k"* ]] && keep=true
        done
        $keep || removable=$((removable + 1))
    done < <(find /usr/share/locale -mindepth 1 -maxdepth 1 -type d 2>/dev/null)

    if (( removable == 0 )); then
        echo -e "   ${DIM}No removable locale directories found.${RESET}"
        return
    fi

    echo "   Found $removable locale directories (keeping: ${keep_locales[*]})"
    echo "   Current locale dir size: $(human_size $before)"

    if dry_run_msg "Would remove $removable unused locale directories"; then
        return
    fi

    if confirm "Remove unused locale directories?"; then
        while IFS= read -r dir; do
            local base
            base=$(basename "$dir")
            local keep=false
            for k in "${keep_locales[@]}"; do
                [[ "$base" == "$k"* ]] && keep=true
            done
            $keep || sudo rm -rf "$dir" 2>/dev/null
        done < <(find /usr/share/locale -mindepth 1 -maxdepth 1 -type d 2>/dev/null)

        local after
        after=$(get_dir_size /usr/share/locale 2>/dev/null || echo 0)
        track_freed "$before" "$after"
        echo -e "   ${GREEN}✓ Done.${RESET}"
        log "Removed $removable unused locale directories"
    else
        echo -e "   ${DIM}Skipped.${RESET}"
    fi
}

clean_docker() {
    is_category_enabled "docker" || return 0
    step_header "Pruning Docker resources"

    if ! command -v docker &>/dev/null; then
        echo -e "   ${DIM}Docker not installed. Skipping.${RESET}"
        return
    fi

    # Check if Docker daemon is running
    if ! docker info &>/dev/null; then
        echo -e "   ${DIM}Docker daemon not running. Skipping.${RESET}"
        return
    fi

    local containers images volumes
    containers=$(docker ps -a --filter status=exited -q 2>/dev/null | wc -l)
    images=$(docker images --filter dangling=true -q 2>/dev/null | wc -l)
    volumes=$(docker volume ls --filter dangling=true -q 2>/dev/null | wc -l)

    echo "   Stopped containers: $containers"
    echo "   Dangling images:    $images"
    echo "   Dangling volumes:   $volumes"

    if (( containers + images + volumes == 0 )); then
        echo -e "   ${DIM}Nothing to prune.${RESET}"
        return
    fi

    if dry_run_msg "Would prune stopped containers, dangling images/volumes & build cache"; then
        return
    fi

    if confirm "Prune Docker resources?"; then
        docker container prune -f 2>/dev/null || true
        docker image prune -f 2>/dev/null || true
        docker volume prune -f 2>/dev/null || true
        docker builder prune -f 2>/dev/null || true
        echo -e "   ${GREEN}✓ Done.${RESET}"
        log "Docker pruned: $containers containers, $images images, $volumes volumes"
    else
        echo -e "   ${DIM}Skipped.${RESET}"
    fi
}

clean_snap() {
    is_category_enabled "snap" || return 0
    step_header "Removing old snap revisions"

    if ! command -v snap &>/dev/null; then
        echo -e "   ${DIM}Snap not installed. Skipping.${RESET}"
        return
    fi

    local old_snaps
    old_snaps=$(snap list --all 2>/dev/null | awk '/disabled/{print $1, $3}')

    if [[ -z "$old_snaps" ]]; then
        echo -e "   ${DIM}No old snap revisions found.${RESET}"
        return
    fi

    local count
    count=$(echo "$old_snaps" | wc -l)
    echo "   Found $count old snap revision(s):"
    echo "$old_snaps" | head -10 | sed 's/^/     /'
    (( count > 10 )) && echo "     ... and $((count - 10)) more"

    if dry_run_msg "Would remove $count old snap revisions"; then
        return
    fi

    if confirm "Remove old snap revisions?"; then
        while IFS= read -r line; do
            local name rev
            name=$(echo "$line" | awk '{print $1}')
            rev=$(echo "$line" | awk '{print $2}')
            sudo snap remove "$name" --revision="$rev" 2>/dev/null || true
        done <<< "$old_snaps"
        echo -e "   ${GREEN}✓ Done.${RESET}"
        log "Removed $count old snap revisions"
    else
        echo -e "   ${DIM}Skipped.${RESET}"
    fi
}


clean_kde_cache() {
    is_category_enabled "kde-cache" || return 0
    step_header "Cleaning KDE/Plasma offline caches"

    echo -e "   ${DIM}Only cleaning caches safe to remove while session is running.${RESET}"

    # Safe to clean while session is running (crash metadata, http cache, old kcache files)
    # NOT safe while live: plasmashell, kwin, ksycoca, plasma-svgelements, icon-cache
    local kde_safe_dirs=(
        "$HOME/.cache/kcrash-metadata"
        "$HOME/.cache/kio_http"
        "$HOME/.cache/kioexec"
        "$HOME/.cache/krunner"
        "$HOME/.cache/kcminit"
    )

    local total_before=0
    local found=false

    for pattern in "${kde_safe_dirs[@]}"; do
        for item in $pattern; do
            if [[ -e "$item" ]]; then
                local s
                s=$(get_dir_size "$item" 2>/dev/null || du -sk "$item" 2>/dev/null | awk '{print $1}')
                s=${s:-0}
                if (( s > 0 )); then
                    found=true
                    total_before=$((total_before + s))
                fi
            fi
        done
    done

    if ! $found; then
        echo -e "   ${DIM}No cleanable KDE/Plasma cache found.${RESET}"
        return
    fi

    echo "   KDE/Plasma safe cache: $(human_size $total_before)"

    if dry_run_msg "Would clear KDE/Plasma offline caches ($(human_size $total_before))"; then
        return
    fi

    if confirm "Clear KDE/Plasma offline caches?"; then
        for pattern in "${kde_safe_dirs[@]}"; do
            for item in $pattern; do
                if [[ -d "$item" ]]; then
                    rm -rf "$item"/* 2>/dev/null
                elif [[ -f "$item" ]]; then
                    rm -f "$item" 2>/dev/null
                fi
            done
        done
        echo -e "   ${GREEN}↳ Freed: $(human_size $total_before)${RESET}"
        TOTAL_FREED=$((TOTAL_FREED + total_before))
        echo -e "   ${GREEN}✓ Done.${RESET}"
        log "Cleaned KDE/Plasma offline caches"
    else
        echo -e "   ${DIM}Skipped.${RESET}"
    fi
}




