    local_files = r2.stdout.strip().split("\n") if r2.returncode == 0 and r2.stdout.strip() else []
    if not local_files:
        return _clean("no unowned files found")
    return _result("clean", f"found {len(local_files)} files in /usr/local/bin (manual review)")


