clean_service_leftovers() {
    is_category_enabled "service-leftovers" || return 0
    step_header "Cleaning leftover systemd links and not-found units"

    local sys_notfound=""
    local user_notfound=""
    local sys_broken_links=""
    local user_broken_links=""

    sys_notfound=$(systemctl list-units --all --plain --no-legend 2>/dev/null | awk '$2=="not-found"{print $1}')
    user_notfound=$(systemctl --user list-units --all --plain --no-legend 2>/dev/null | awk '$2=="not-found"{print $1}')
    sys_broken_links=$(find /etc/systemd/system /etc/systemd/user -xtype l 2>/dev/null)
    user_broken_links=$(find "$HOME/.config/systemd/user" -xtype l 2>/dev/null)

    local sys_nf_count=0
    local user_nf_count=0
    local sys_link_count=0
    local user_link_count=0
    [[ -n "$sys_notfound" ]] && sys_nf_count=$(echo "$sys_notfound" | wc -l)
    [[ -n "$user_notfound" ]] && user_nf_count=$(echo "$user_notfound" | wc -l)
    [[ -n "$sys_broken_links" ]] && sys_link_count=$(echo "$sys_broken_links" | wc -l)
    [[ -n "$user_broken_links" ]] && user_link_count=$(echo "$user_broken_links" | wc -l)

    local total_items=$((sys_nf_count + user_nf_count + sys_link_count + user_link_count))
    if (( total_items == 0 )); then
        echo -e "   ${DIM}No leftover systemd links/units found.${RESET}"
        return
    fi

    (( sys_link_count > 0 )) && echo "   Broken system links: $sys_link_count"
    (( user_link_count > 0 )) && echo "   Broken user links: $user_link_count"
    (( sys_nf_count > 0 )) && echo "   System not-found units: $sys_nf_count"
    (( user_nf_count > 0 )) && echo "   User not-found units: $user_nf_count"

    if dry_run_msg "Would clean $total_items leftover systemd links/units"; then
        return
    fi

    if confirm "Remove/disable these leftover systemd entries?"; then
        if [[ -n "$sys_broken_links" ]]; then
            while IFS= read -r link; do
                sudo rm -f "$link" 2>/dev/null || true
            done <<< "$sys_broken_links"
        fi
        if [[ -n "$user_broken_links" ]]; then
            while IFS= read -r link; do
                rm -f "$link" 2>/dev/null || true
            done <<< "$user_broken_links"
        fi
        if [[ -n "$sys_notfound" ]]; then
            while IFS= read -r unit; do
                sudo systemctl disable "$unit" 2>/dev/null || true
                sudo systemctl reset-failed "$unit" 2>/dev/null || true
            done <<< "$sys_notfound"
        fi
        if [[ -n "$user_notfound" ]]; then
            while IFS= read -r unit; do
                systemctl --user disable "$unit" 2>/dev/null || true
                systemctl --user reset-failed "$unit" 2>/dev/null || true
            done <<< "$user_notfound"
        fi
        sudo systemctl daemon-reload 2>/dev/null || true
        systemctl --user daemon-reload 2>/dev/null || true

        echo -e "   ${GREEN}✓ Done.${RESET}"
        log "Cleaned leftover systemd entries: $total_items"
    else
        echo -e "   ${DIM}Skipped.${RESET}"
    fi
}

