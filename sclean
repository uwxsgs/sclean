def clean_recent_files(dry_run):
    """Clean GTK recent files list and similar trackers."""
    home = Path.home()
    files = [
        home / ".local" / "share" / "recently-used.xbel",
        home / ".local" / "share" / "recently-used.xbel.bak",
    ]
    total = 0
    found = []
    for f in files:
        if f.is_file():
            try:
                total += f.stat().st_size
                found.append(f)
            except OSError:
                pass
    if not found:
        return _clean("no recent files list")
    total_kb = total // 1024
    if dry_run:
        return _scanned(f"would clear recent files list ({human_kb(total_kb)})")
    for f in found:
        try:
            f.write_text("")  # truncate rather than delete (apps recreate it)
        except OSError:
            pass
    return _freed(total_kb) if total_kb > 0 else _result("freed", "cleared recent files")


def clean_unowned_files(dry_run):
    """Check for files not owned by any package in key dirs (info only)."""
    if not _has("pacman"):
        return _skipped()
    # Quick check in /etc and /usr/local only
    r = _run(["pacman", "-Qqo", "/etc/"], timeout=30)
