    local total_before=0
    local found=false

    # Helper: check directory and accumulate size
    check_dev_dir() {
        local label="$1" dir="$2"
        if [[ -d "$dir" ]]; then
            local s
            s=$(get_dir_size "$dir")
            if (( s > 0 )); then
                found=true
                echo "   $label: $(human_size $s)"
                total_before=$((total_before + s))
            fi
        fi
    }

    # npm cache (check dir directly — npm may not be in bash PATH)
    check_dev_dir "npm cache" "$HOME/.npm"

    # pip cache
    check_dev_dir "pip cache" "$HOME/.cache/pip"

    # Go module cache
    local go_mod_dir="$HOME/go/pkg/mod"
    command -v go &>/dev/null && go_mod_dir=$(go env GOMODCACHE 2>/dev/null || echo "$go_mod_dir")
    check_dev_dir "Go module cache" "$go_mod_dir"

    # Cargo/Rust registry cache
    check_dev_dir "Cargo registry cache" "$HOME/.cargo/registry"

    # Gradle cache
    check_dev_dir "Gradle cache" "$HOME/.gradle/caches"

    # Maven cache
    check_dev_dir "Maven cache" "$HOME/.m2/repository"

    # Composer cache
    check_dev_dir "Composer cache" "$HOME/.cache/composer"

    # Gem cache
    check_dev_dir "Gem cache" "$HOME/.local/share/gem"

    # Yarn cache
    check_dev_dir "Yarn cache" "$HOME/.cache/yarn"
    check_dev_dir "Yarn cache (v2+)" "$HOME/.yarn/cache"

    # pnpm cache
    check_dev_dir "pnpm cache" "$HOME/.local/share/pnpm/store"

    # Playwright browsers
    check_dev_dir "Playwright browsers" "$HOME/.cache/ms-playwright-go"
    check_dev_dir "Playwright browsers" "$HOME/.cache/ms-playwright"

    if ! $found; then
        echo -e "   ${DIM}No developer caches found.${RESET}"
        return
    fi

    echo "   Total: $(human_size $total_before)"

    if dry_run_msg "Would clean developer caches ($(human_size $total_before))"; then
        return
    fi

    if confirm "Clean developer caches?"; then
        command -v npm &>/dev/null && npm cache clean --force 2>/dev/null || true
        (command -v pip &>/dev/null || command -v pip3 &>/dev/null) && pip cache purge 2>/dev/null || true
        command -v go &>/dev/null && go clean -modcache 2>/dev/null || true
        if command -v cargo &>/dev/null; then
            cargo cache -a 2>/dev/null || rm -rf "$HOME/.cargo/registry/cache"/* 2>/dev/null
        fi
        command -v composer &>/dev/null && composer clear-cache 2>/dev/null || true
        # Direct directory removal for caches that don't need a tool
        [[ -d "$HOME/.npm" ]] && rm -rf "$HOME/.npm"/_cacache 2>/dev/null
        [[ -d "$HOME/.cache/pip" ]] && rm -rf "$HOME/.cache/pip"/* 2>/dev/null
        [[ -d "$HOME/.gradle/caches" ]] && rm -rf "$HOME/.gradle/caches"/* 2>/dev/null
        [[ -d "$HOME/.m2/repository" ]] && rm -rf "$HOME/.m2/repository"/* 2>/dev/null
        [[ -d "$HOME/.cache/yarn" ]] && rm -rf "$HOME/.cache/yarn"/* 2>/dev/null
        [[ -d "$HOME/.yarn/cache" ]] && rm -rf "$HOME/.yarn/cache"/* 2>/dev/null
        [[ -d "$HOME/.local/share/pnpm/store" ]] && rm -rf "$HOME/.local/share/pnpm/store"/* 2>/dev/null
        [[ -d "$HOME/.cache/ms-playwright-go" ]] && rm -rf "$HOME/.cache/ms-playwright-go"/* 2>/dev/null
        [[ -d "$HOME/.cache/ms-playwright" ]] && rm -rf "$HOME/.cache/ms-playwright"/* 2>/dev/null
