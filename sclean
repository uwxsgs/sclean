    local total_before=0
    if [[ -n "$crash_dirs" ]]; then
        echo "   Crash report directories:"
        while IFS= read -r dir; do
            local s
            s=$(get_dir_size_human "$dir")
            echo "     $dir ($s)"
            total_before=$((total_before + $(get_dir_size "$dir")))
        done <<< "$crash_dirs"
    fi

    if [[ -n "$crash_files" ]]; then
        local fcount
