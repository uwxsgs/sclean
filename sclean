def clean_stale_procs(dry_run):
    """Kill stale user processes with deleted binaries."""
    uid = os.getuid()
    stale = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if pid in (os.getpid(), os.getppid()):
            continue
        try:
            status = (entry / "status").read_text()
            lines = {l.split(":")[0]: l.split(":", 1)[1].strip()
                     for l in status.split("\n") if ":" in l}
            if int(lines.get("Uid", "").split()[0]) != uid:
                continue
            exe = os.readlink(str(entry / "exe"))
            if "(deleted)" not in exe:
                continue
            comm = lines.get("Name", "?")
            rss = int(lines.get("VmRSS", "0").split()[0])
            stale.append((pid, comm, rss))
        except (OSError, IndexError, ValueError, KeyError):
            continue
    if not stale:
        return _clean("no stale processes")
    total_rss = sum(r for _, _, r in stale)
    if dry_run:
        return _scanned(f"would terminate {len(stale)} stale procs ({human_kb(total_rss)})")
    pids = [p for p, _, _ in stale]
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    time.sleep(1)
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    return _result("freed", f"terminated {len(stale)} stale processes")

