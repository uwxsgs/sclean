clean_user_cache() {
    is_category_enabled "user-cache" || return 0
    step_header "Cleaning old user caches and config backups"

    local total_before=0
    local found=false

    # Search for cache files untouched for 30+ days
    local cache_count
    cache_count=$(find "$HOME/.cache" -mindepth 1 -type f -atime +30 2>/dev/null | wc -l)
    
    # Search for backup files in config/data dirs
    local config_bak
    config_bak=$(find "$HOME/.config" "$HOME/.local/share" -type f \( -name "*.bak" -o -name "*.old" -o -name "*~" -o -name "*.swp" -o -name "*.pacsave" \) 2>/dev/null | wc -l)

    if (( cache_count == 0 && config_bak == 0 )); then
        echo -e "   ${DIM}No old cache or backup files found.${RESET}"
        return
    fi

    (( cache_count > 0 )) && echo "   Found $cache_count old cache file(s) (>30 days unaccessed)."
    (( config_bak > 0 )) && echo "   Found $config_bak backup/old file(s) in .config/.local."

    if dry_run_msg "Would remove old cache and config backups"; then
        return
    fi

    if confirm "Clean old caches and config backups?"; then
        if (( cache_count > 0 )); then
            find "$HOME/.cache" -mindepth 1 -type f -atime +30 -delete 2>/dev/null
            find "$HOME/.cache" -mindepth 1 -type d -empty -delete 2>/dev/null
        fi
        
        if (( config_bak > 0 )); then
            find "$HOME/.config" "$HOME/.local/share" -type f \( -name "*.bak" -o -name "*.old" -o -name "*~" -o -name "*.swp" -o -name "*.pacsave" \) -delete 2>/dev/null
        fi
        
        echo -e "   ${GREEN}✓ Done.${RESET}"
        log "Removed $cache_count old cache files, $config_bak config backups"
    else
        echo -e "   ${DIM}Skipped.${RESET}"
    fi
}

