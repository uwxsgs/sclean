# ─────────────────────────────────────────────────────────
#  UTILITY HELPERS
# ─────────────────────────────────────────────────────────

def _run(cmd, timeout=60):
    """Run a command quietly, return CompletedProcess."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return subprocess.CompletedProcess(cmd, 1, "", "")


def _has(cmd):
    """Check if a command exists on PATH."""
    return shutil.which(cmd) is not None


def _dir_size_kb(path):
    """Return size of a path in KB."""
    try:
        r = subprocess.run(["du", "-sk", str(path)],
                           capture_output=True, text=True, timeout=15)
        if r.returncode == 0 and r.stdout.strip():
            return int(r.stdout.split()[0])
    except (subprocess.TimeoutExpired, ValueError, IndexError, OSError):
        pass
    # Fallback: os.walk
    total = 0
    try:
        for dirpath, _, filenames in os.walk(str(path)):
            for f in filenames:
                try:
                    total += os.path.getsize(os.path.join(dirpath, f))
                except OSError:
                    pass
    except OSError:
        pass
    return total // 1024


def _rm_contents(path):
    """Remove all contents of a directory (user-owned)."""
    p = Path(path)
    if not p.is_dir():
        return
    for item in p.iterdir():
        try:
            if item.is_dir():
                shutil.rmtree(item, ignore_errors=True)
            else:
                item.unlink(missing_ok=True)
        except OSError:
            pass


def _find(*args, timeout=30):
    """Run find command, return list of matching paths."""
    try:
        r = subprocess.run(["find"] + [str(a) for a in args],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           text=True, timeout=timeout)
        return [f for f in r.stdout.strip().split("\n") if f] if r.stdout.strip() else []
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return []


def human(n):
    """Human-readable size from bytes."""
    for u in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024:
            return f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.1f} PB"


def human_kb(kb):
    """Human-readable size from KB."""
    return human(kb * 1024)


# ─────────────────────────────────────────────────────────
#  CLEANUP RESULT HELPERS
# ─────────────────────────────────────────────────────────

def _result(status="clean", detail="", freed_kb=0):
    return {"status": status, "detail": detail, "freed_kb": freed_kb}

def _clean(detail="nothing to clean"):
    return _result("clean", detail)

def _freed(kb, detail=""):
    return _result("freed", detail or f"freed {human_kb(kb)}", kb)

def _scanned(detail):
    return _result("scanned", detail)

def _skipped(detail="not installed"):
    return _result("skipped", detail)


