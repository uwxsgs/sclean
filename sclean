# Execution order in sclean (matches function call order in the script)
EXEC_ORDER = [c[0] for c in CATEGORIES]
CAT_LABEL = {c[0]: c[1] for c in CATEGORIES}
CAT_DESC = {c[0]: c[2] for c in CATEGORIES}
OPTIN_START = next(i for i, c in enumerate(CATEGORIES) if c[3])

# ─────────────────────────────────────────────────────────
#  COLORS
# ─────────────────────────────────────────────────────────

C_BORDER = 1
C_TEXT = 2
C_DIM = 3
C_HIGHLIGHT = 4
C_GREEN = 5
C_RED = 6
C_YELLOW = 7
C_BAR = 8
C_ACCENT = 9


def init_colors():
    curses.start_color()
    try:
        curses.use_default_colors()
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK
    curses.init_pair(C_BORDER, curses.COLOR_CYAN, bg)
    curses.init_pair(C_TEXT, curses.COLOR_WHITE, bg)
    curses.init_pair(C_DIM, curses.COLOR_WHITE, bg)       # used with A_DIM
    curses.init_pair(C_HIGHLIGHT, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(C_GREEN, curses.COLOR_GREEN, bg)
    curses.init_pair(C_RED, curses.COLOR_RED, bg)
    curses.init_pair(C_YELLOW, curses.COLOR_YELLOW, bg)
    curses.init_pair(C_BAR, curses.COLOR_GREEN, bg)
    curses.init_pair(C_ACCENT, curses.COLOR_MAGENTA, bg)


# ─────────────────────────────────────────────────────────
#  DRAWING HELPERS
# ─────────────────────────────────────────────────────────

def put(scr, y, x, s, attr=0):
    h, w = scr.getmaxyx()
    if y < 0 or y >= h or x >= w:
        return
    if x < 0:
        s = s[-x:]
        x = 0
    try:
        scr.addstr(y, x, s[:w - x], attr)
    except curses.error:
        pass


def hline(scr, y, x, width, attr=0):
    put(scr, y, x, "─" * width, attr)


def disk_info():
    try:
        st = os.statvfs("/")
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        used = total - free
        pct = used / total * 100 if total > 0 else 0
        return {"total": total, "used": used, "free": free, "pct": pct}
    except OSError:
        return {"total": 0, "used": 0, "free": 0, "pct": 0}


def human(n):
    for u in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024:
            return f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.1f} PB"


def draw_bar(scr, y, x, width, pct, color_pair):
    """Draw a usage bar. pct is 0-100."""
    filled = int(pct / 100 * width)
    put(scr, y, x, "█" * filled, curses.color_pair(color_pair) | curses.A_BOLD)
    put(scr, y, x + filled, "░" * (width - filled), curses.color_pair(C_DIM) | curses.A_DIM)


def bar_color(pct):
    if pct > 90:
        return C_RED
    elif pct > 75:
        return C_YELLOW
    return C_GREEN


def draw_header(scr, title_extra=""):
    _, w = scr.getmaxyx()
    d = disk_info()
    title = f"  sclean{title_extra}"
    disk_str = f"{human(d['used'])} / {human(d['total'])} ({d['pct']:.0f}%)  "

    put(scr, 0, 0, title, curses.color_pair(C_BORDER) | curses.A_BOLD)
    put(scr, 0, w - len(disk_str), disk_str, curses.color_pair(C_DIM) | curses.A_DIM)
    hline(scr, 1, 0, w, curses.color_pair(C_BORDER))

    # Disk bar
    bar_w = min(w - 24, 50)
    draw_bar(scr, 2, 2, bar_w, d['pct'], bar_color(d['pct']))
    put(scr, 2, bar_w + 4, f"{human(d['free'])} free",
        curses.color_pair(C_DIM) | curses.A_DIM)


def draw_footer(scr, text):
    h, w = scr.getmaxyx()
    hline(scr, h - 2, 0, w, curses.color_pair(C_BORDER))
    put(scr, h - 1, 2, text[:w - 4], curses.color_pair(C_DIM) | curses.A_DIM)


# ─────────────────────────────────────────────────────────
#  SUDO PRE-AUTH (runs before curses)
# ─────────────────────────────────────────────────────────

def ensure_sudo():
    if os.geteuid() == 0:
        return True
    print()
    print("  ┌─────────────────────────────────────────┐")
    print("  │  sclean — System Cleanup                │")
    print("  │                                         │")
    print("  │  Some operations require root access.   │")
    print("  │  You may be prompted for your password. │")
    print("  └─────────────────────────────────────────┘")
    print()
    result = subprocess.run(["sudo", "-v"])
    if result.returncode != 0:
        print("  Could not authenticate. Continuing with limited access.\n")
        time.sleep(1)
        return False
    print("  ✓ Authenticated.\n")
    time.sleep(0.3)

    # Keep sudo alive in background
    def keepalive():
        while True:
            time.sleep(55)
            subprocess.run(["sudo", "-v"], capture_output=True)
    threading.Thread(target=keepalive, daemon=True).start()
    return True


# ─────────────────────────────────────────────────────────
#  SCREEN 1: CATEGORY SELECTION
# ─────────────────────────────────────────────────────────

def screen_select(scr):
    """Returns (selected_cat_ids, dry_run) or (None, False) if quit."""
    selected = [not c[3] for c in CATEGORIES]  # defaults: all non-optin
    cursor = 0
    scroll = 0
    dry_run = False

    while True:
        h, w = scr.getmaxyx()
        scr.erase()
        draw_header(scr)

        # Section title
        sel_count = sum(selected)
        put(scr, 4, 2, "Select categories",
            curses.color_pair(C_TEXT) | curses.A_BOLD)
        counter = f"{sel_count} of {len(CATEGORIES)} selected"
        put(scr, 4, w - len(counter) - 2, counter,
            curses.color_pair(C_BORDER))

        # List area
        list_y = 6
        list_h = h - 10  # room for header (5) + footer (3) + dry-run (2)

        # Scroll
        if cursor < scroll:
            scroll = cursor
        if cursor >= scroll + list_h:
            scroll = cursor - list_h + 1

        for vi in range(list_h):
            i = scroll + vi
            if i >= len(CATEGORIES):
                break

            cat_id, label, desc, optin = CATEGORIES[i]
            y = list_y + vi

            # Opt-in separator
            if i == OPTIN_START and i == scroll + vi:
                if vi > 0:
                    put(scr, y, 2, "── opt-in ", curses.color_pair(C_ACCENT))
                    hline(scr, y, 12, w - 14, curses.color_pair(C_ACCENT) | curses.A_DIM)
                    continue

            is_cur = (i == cursor)

            # Build the row
            check = "✓" if selected[i] else " "
            arrow = "▸" if is_cur else " "

            if is_cur:
                # Highlighted row
                row_attr = curses.color_pair(C_HIGHLIGHT)
                put(scr, y, 1, " " * (w - 2), row_attr)
                put(scr, y, 2, f" [{check}]  {label:<20s}{desc}", row_attr)
            else:
                # Normal row
                put(scr, y, 2, arrow, curses.color_pair(C_BORDER))
                check_attr = curses.color_pair(C_GREEN) | curses.A_BOLD if selected[i] else curses.color_pair(C_DIM) | curses.A_DIM
                put(scr, y, 4, f"[{check}]", check_attr)
                label_attr = curses.color_pair(C_TEXT) if not optin else curses.color_pair(C_ACCENT)
                put(scr, y, 10, f"{label:<20s}", label_attr)
                put(scr, y, 30, desc[:w - 32], curses.color_pair(C_DIM) | curses.A_DIM)

        # Scroll indicators
        if scroll > 0:
            put(scr, list_y, w - 1, "▲", curses.color_pair(C_BORDER))
        if scroll + list_h < len(CATEGORIES):
            put(scr, list_y + list_h - 1, w - 1, "▼", curses.color_pair(C_BORDER))

        # Dry run toggle
        dr_y = h - 4
        dr_check = "✓" if dry_run else " "
        dr_attr = curses.color_pair(C_YELLOW) | curses.A_BOLD if dry_run else curses.color_pair(C_DIM) | curses.A_DIM
        put(scr, dr_y, 2, f"  [{dr_check}]  Dry run — preview only, nothing deleted", dr_attr)

        # Footer
        draw_footer(scr,
            "Space:toggle  A:all  N:none  D:defaults  Tab:dry-run  Enter:start  Q:quit")

        scr.refresh()

        key = scr.getch()
        if key == curses.KEY_UP:
            cursor = max(0, cursor - 1)
            # Skip separator
            if cursor == OPTIN_START and scroll + (cursor - scroll) > 0:
                cursor = max(0, cursor - 1)
        elif key == curses.KEY_DOWN:
            cursor = min(len(CATEGORIES) - 1, cursor + 1)
        elif key == ord(' '):
            selected[cursor] = not selected[cursor]
        elif key in (ord('a'), ord('A')):
            selected = [True] * len(CATEGORIES)
        elif key in (ord('n'), ord('N')):
            selected = [False] * len(CATEGORIES)
        elif key in (ord('d'), ord('D')):
            selected = [not c[3] for c in CATEGORIES]
        elif key == 9:  # Tab
            dry_run = not dry_run
        elif key in (10, 13, curses.KEY_ENTER):
            chosen = [CATEGORIES[i][0] for i in range(len(CATEGORIES)) if selected[i]]
            if not chosen:
                put(scr, dr_y + 1, 2, "  Select at least one category.",
                    curses.color_pair(C_RED) | curses.A_BOLD)
                scr.refresh()
                time.sleep(1)
                continue
            return chosen, dry_run
        elif key in (ord('q'), ord('Q')):
            return None, False


# ─────────────────────────────────────────────────────────
#  SCREEN 2: CLEANUP PROGRESS
# ─────────────────────────────────────────────────────────

def screen_progress(scr, selected, dry_run):
    """Run cleanup and show structured progress. Returns per-category results."""
    ordered = [c for c in EXEC_ORDER if c in selected]
    total = len(ordered)

    # Per-category state
    state = {}
    for c in ordered:
        state[c] = {"status": "pending", "detail": "", "freed": ""}

    current_step = [0]
    current_cat = [None]
    done = [False]
    raw_lines = []
    freed_total = [0]  # in KB

    def worker():
        cmd = [SCLEAN, "-y"]
        if dry_run:
            cmd.append("-n")
        cmd += ["--only", ",".join(selected)]

        try:
            proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1, env={**os.environ, "TERM": "dumb"}
            )
            for line in proc.stdout:
                clean = re.sub(r'\x1b\[[0-9;]*m', '', line.rstrip())
                raw_lines.append(clean)

                # Step header: [N/M] description
                m = re.match(r'\[(\d+)/(\d+)\]\s*(.*)', clean)
                if m:
                    step_num = int(m.group(1))
                    current_step[0] = step_num

                    # Finalize previous category
                    prev = current_cat[0]
                    if prev and state[prev]["status"] == "running":
                        state[prev]["status"] = "clean"
                        if not state[prev]["detail"]:
                            state[prev]["detail"] = "nothing to clean"

                    # Start new category
                    if step_num <= len(ordered):
                        cat = ordered[step_num - 1]
                        current_cat[0] = cat
                        state[cat]["status"] = "running"
                    continue

                cat = current_cat[0]
                if not cat:
                    continue

                low = clean.strip().lower()

                # Parse meaningful lines
                if "nothing to clean" in low or re.match(r'^no\s+(cleanable|orphan|broken|stale|failed)', low):
                    state[cat]["status"] = "clean"
                    state[cat]["detail"] = "nothing to clean"
                elif "freed:" in low:
                    fm = re.search(r'Freed:\s*(\S+)', clean)
                    if fm:
                        state[cat]["freed"] = fm.group(1)
                        state[cat]["status"] = "freed"
                        # Try to accumulate KB
                        size_str = fm.group(1)
                        kb = parse_size_to_kb(size_str)
                        freed_total[0] += kb
                elif "[dry run]" in low:
                    state[cat]["status"] = "scanned"
                    dm = re.search(r'Would\s+(.*)', clean, re.IGNORECASE)
                    if dm:
                        state[cat]["detail"] = dm.group(1).strip()[:60]
                elif "skipped" in low:
                    state[cat]["status"] = "skipped"
                    state[cat]["detail"] = "skipped"
                elif "found" in low:
                    fm = re.search(r'Found\s+(.*)', clean, re.IGNORECASE)
                    if fm:
                        state[cat]["detail"] = fm.group(1).strip()[:60]
                elif "done" in low or "✓" in clean:
                    if state[cat]["status"] == "running":
                        state[cat]["status"] = "freed" if state[cat]["freed"] else "clean"

            # Finalize last category
            if current_cat[0] and state[current_cat[0]]["status"] == "running":
                state[current_cat[0]]["status"] = "clean"

            proc.wait()
        except Exception as e:
            raw_lines.append(f"Error: {e}")
        done[0] = True

    thread = threading.Thread(target=worker, daemon=True)
    thread.start()

    spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    frame = 0
    scroll = 0

    scr.nodelay(True)
    scr.timeout(60)

    while not done[0]:
        h, w = scr.getmaxyx()
        scr.erase()

        mode = "Dry Run" if dry_run else "Cleaning"
        s = spinner[frame % len(spinner)]
        draw_header(scr, f" — {s} {mode}...")

        # Progress bar
        progress = current_step[0] / max(total, 1)
        bar_w = min(w - 20, 50)
        put(scr, 4, 2, "Progress", curses.color_pair(C_TEXT) | curses.A_BOLD)
        draw_bar(scr, 4, 11, bar_w, progress * 100, C_GREEN)
        put(scr, 4, 11 + bar_w + 2,
            f"{current_step[0]}/{total}",
            curses.color_pair(C_BORDER))

        # Category status list
        list_y = 6
        list_h = h - 8

        if len(ordered) > list_h:
            # Auto-scroll to keep current step visible
            active_idx = max(0, current_step[0] - 1)
            if active_idx >= scroll + list_h - 2:
                scroll = active_idx - list_h + 3
            scroll = max(0, min(scroll, len(ordered) - list_h))

        for vi in range(min(list_h, len(ordered) - scroll)):
            idx = scroll + vi
            if idx >= len(ordered):
                break
            cat = ordered[idx]
            y = list_y + vi
            st = state[cat]
            label = CAT_LABEL.get(cat, cat)

            # Status icon and color
            if st["status"] == "freed":
                icon = "✓"
                icon_attr = curses.color_pair(C_GREEN) | curses.A_BOLD
                detail = f"freed {st['freed']}" if st['freed'] else "cleaned"
                detail_attr = curses.color_pair(C_GREEN) | curses.A_BOLD
            elif st["status"] == "clean":
                icon = "✓"
                icon_attr = curses.color_pair(C_GREEN)
                detail = st["detail"] or "nothing to clean"
                detail_attr = curses.color_pair(C_DIM) | curses.A_DIM
            elif st["status"] == "scanned":
                icon = "~"
                icon_attr = curses.color_pair(C_YELLOW)
                detail = st["detail"] or "scanned"
                detail_attr = curses.color_pair(C_YELLOW)
            elif st["status"] == "running":
                icon = spinner[frame % len(spinner)]
                icon_attr = curses.color_pair(C_YELLOW) | curses.A_BOLD
                detail = "working..."
                detail_attr = curses.color_pair(C_YELLOW)
            elif st["status"] == "skipped":
                icon = "—"
                icon_attr = curses.color_pair(C_DIM) | curses.A_DIM
                detail = "skipped"
                detail_attr = curses.color_pair(C_DIM) | curses.A_DIM
            else:  # pending
                icon = "·"
                icon_attr = curses.color_pair(C_DIM) | curses.A_DIM
                detail = ""
                detail_attr = curses.color_pair(C_DIM) | curses.A_DIM

            put(scr, y, 3, icon, icon_attr)
            put(scr, y, 6, f"{label:<20s}", curses.color_pair(C_TEXT))
            put(scr, y, 27, detail[:w - 30], detail_attr)

        draw_footer(scr, "Working... please wait")
        scr.refresh()
        frame += 1

        # Absorb keypresses
        scr.getch()

    scr.nodelay(False)
    scr.timeout(-1)

    return state, freed_total[0]


def parse_size_to_kb(s):
    """Parse a human-readable size string to KB."""
    m = re.match(r'([\d.]+)\s*([KMGTP])', s, re.IGNORECASE)
    if not m:
        return 0
    val = float(m.group(1))
    unit = m.group(2).upper()
    mult = {"K": 1, "M": 1024, "G": 1024**2, "T": 1024**3, "P": 1024**4}
    return int(val * mult.get(unit, 1))


# ─────────────────────────────────────────────────────────
#  SCREEN 3: SUMMARY
# ─────────────────────────────────────────────────────────

def screen_summary(scr, state, disk_before, freed_kb, dry_run):
    disk_after = disk_info()
    ordered = list(state.keys())

    # Separate results into categories
    freed_cats = [(c, state[c]) for c in ordered if state[c]["status"] == "freed"]
    clean_cats = [(c, state[c]) for c in ordered if state[c]["status"] == "clean"]
    other_cats = [(c, state[c]) for c in ordered if state[c]["status"] not in ("freed", "clean")]

    while True:
        h, w = scr.getmaxyx()
        scr.erase()

        if dry_run:
            draw_header(scr, " — Dry Run Complete")
        else:
            draw_header(scr, " — Cleanup Complete ✓")

        y = 4

        # Total freed
        if freed_kb > 0 and not dry_run:
            freed_str = human(freed_kb * 1024)
            put(scr, y, 2, f"Total freed: {freed_str}",
                curses.color_pair(C_GREEN) | curses.A_BOLD)
        elif dry_run:
            put(scr, y, 2, "Dry run — nothing was deleted",
                curses.color_pair(C_YELLOW))
        else:
            put(scr, y, 2, "System was already clean",
                curses.color_pair(C_DIM) | curses.A_DIM)
        y += 2

        # Before/after bars
        bar_w = min(w - 30, 45)
        put(scr, y, 2, "Before", curses.color_pair(C_DIM) | curses.A_DIM)
        draw_bar(scr, y, 10, bar_w, disk_before['pct'], bar_color(disk_before['pct']))
        put(scr, y, 10 + bar_w + 2, f"{disk_before['pct']:.0f}%",
            curses.color_pair(C_DIM) | curses.A_DIM)

        if not dry_run:
            y += 1
            put(scr, y, 2, "After ", curses.color_pair(C_DIM) | curses.A_DIM)
            draw_bar(scr, y, 10, bar_w, disk_after['pct'], bar_color(disk_after['pct']))
            put(scr, y, 10 + bar_w + 2, f"{disk_after['pct']:.0f}%",
                curses.color_pair(C_GREEN))
        y += 2

        hline(scr, y, 2, w - 4, curses.color_pair(C_BORDER))
        y += 1

        # Freed categories
        max_rows = h - y - 3
        row = 0

        if freed_cats and row < max_rows:
            for cat_id, st in freed_cats:
                if row >= max_rows:
                    break
                label = CAT_LABEL.get(cat_id, cat_id)
                freed_str = st["freed"] or "cleaned"
                put(scr, y + row, 3, "✓", curses.color_pair(C_GREEN) | curses.A_BOLD)
                put(scr, y + row, 6, f"{label:<20s}", curses.color_pair(C_TEXT))
                put(scr, y + row, 27, freed_str,
                    curses.color_pair(C_GREEN) | curses.A_BOLD)
                row += 1

        # Scanned (dry run results)
        if dry_run and other_cats and row < max_rows:
            for cat_id, st in other_cats:
                if row >= max_rows:
                    break
                if st["status"] == "scanned":
                    label = CAT_LABEL.get(cat_id, cat_id)
                    put(scr, y + row, 3, "~", curses.color_pair(C_YELLOW))
                    put(scr, y + row, 6, f"{label:<20s}", curses.color_pair(C_TEXT))
                    put(scr, y + row, 27, st["detail"][:w - 30],
                        curses.color_pair(C_YELLOW))
                    row += 1

        # Clean summary (collapsed)
        if clean_cats and row < max_rows:
            put(scr, y + row, 3, "·", curses.color_pair(C_DIM) | curses.A_DIM)
            put(scr, y + row, 6,
                f"{len(clean_cats)} {'category' if len(clean_cats) == 1 else 'categories'} already clean",
                curses.color_pair(C_DIM) | curses.A_DIM)

        draw_footer(scr, "B:run again  Q:quit")
        scr.refresh()

        key = scr.getch()
        if key in (ord('q'), ord('Q')):
            return "quit"
        elif key in (ord('b'), ord('B')):
            return "again"


# ─────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────

def main(stdscr):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    init_colors()

    while True:
        chosen, dry_run = screen_select(stdscr)
        if chosen is None:
            break

        disk_before = disk_info()

        state, freed_kb = screen_progress(stdscr, chosen, dry_run)

        action = screen_summary(stdscr, state, disk_before, freed_kb, dry_run)
        if action == "quit":
            break


if __name__ == "__main__":
    SCLEAN = _find_sclean_core()

    # If called with any CLI arguments, pass through to sclean-core directly
    # (preserves full CLI compatibility: sclean -n -y --only cache, etc.)
    if len(sys.argv) > 1:
        os.execvp(SCLEAN, [SCLEAN] + sys.argv[1:])

    # No arguments: launch TUI
    ensure_sudo()
    curses.wrapper(main)
