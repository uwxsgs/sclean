    current = r.stdout.strip().split("\n") if r.returncode == 0 and r.stdout.strip() else []
    if not current:
        return _clean("deep orphans already resolved")
    if _has("paru"):
        pkg_cmd = ["paru", "-Rns", "--noconfirm"]
    elif _has("yay"):
        pkg_cmd = ["yay", "-Rns", "--noconfirm"]
    else:
        pkg_cmd = ["sudo", "pacman", "-Rns", "--noconfirm"]
    _run(pkg_cmd + current, timeout=120)
    return _result("freed", f"removed {count} deep orphans")


def clean_cache(dry_run):
    """Clean pacman + AUR package cache (yay/paru)."""
    pkg_dir = Path("/var/cache/pacman/pkg")
    yay_dir = Path.home() / ".cache" / "yay"
    paru_dir = Path.home() / ".cache" / "paru"
    before = _dir_size_kb(pkg_dir) if pkg_dir.is_dir() else 0
    if yay_dir.is_dir():
        before += _dir_size_kb(yay_dir)
    if paru_dir.is_dir():
        before += _dir_size_kb(paru_dir)
    if dry_run:
        return _scanned(f"would clean cache ({human_kb(before)})")
    if _has("paccache"):
        _run(["sudo", "paccache", "-rk1"], timeout=120)
        _run(["sudo", "paccache", "-ruk0"], timeout=120)
    elif _has("paru"):
        _run(["paru", "-Scc", "--noconfirm"], timeout=120)
    elif _has("yay"):
        _run(["yay", "-Scc", "--noconfirm"], timeout=120)
    else:
        _run(["sudo", "pacman", "-Scc", "--noconfirm"], timeout=120)
    if yay_dir.is_dir():
        _rm_contents(yay_dir)
    if paru_dir.is_dir():
        _rm_contents(paru_dir)
    after = _dir_size_kb(pkg_dir) if pkg_dir.is_dir() else 0
    if yay_dir.is_dir():
        after += _dir_size_kb(yay_dir)
    if paru_dir.is_dir():
        after += _dir_size_kb(paru_dir)
    freed = max(0, before - after)
    return _freed(freed) if freed > 0 else _clean()


def clean_journal(dry_run):
    """Vacuum systemd journal to 50MB."""
    journal_dir = Path("/var/log/journal")
    before = _dir_size_kb(journal_dir) if journal_dir.exists() else 0
    if dry_run:
        return _scanned(f"would vacuum journal ({human_kb(before)})")
    _run(["sudo", "journalctl", "--vacuum-size=50M"], timeout=30)
    after = _dir_size_kb(journal_dir) if journal_dir.exists() else 0
    freed = max(0, before - after)
    return _freed(freed) if freed > 0 else _clean()


def clean_flatpak(dry_run):
    """Remove unused Flatpak runtimes."""
    if not _has("flatpak"):
        return _skipped()
    r = _run(["flatpak", "list", "--unused"])
    if not r.stdout.strip():
        return _clean("no unused runtimes")
    count = len(r.stdout.strip().split("\n"))
    if dry_run:
        return _scanned(f"would remove {count} unused runtimes")
    _run(["flatpak", "uninstall", "--unused", "--delete-data", "-y"], timeout=120)
    return _result("freed", f"removed {count} runtimes")


def clean_flatpak_data(dry_run):
    """Remove orphaned Flatpak app data from ~/.var/app."""
    if not _has("flatpak"):
        return _skipped()
    data_root = Path.home() / ".var" / "app"
    if not data_root.is_dir():
        return _clean("no app data dir")
    r = _run(["flatpak", "list", "--app", "--columns=application"])
    installed = set(r.stdout.strip().split("\n")) if r.stdout.strip() else set()
    orphans = [d for d in data_root.iterdir() if d.is_dir() and d.name not in installed]
    if not orphans:
        return _clean("no orphaned app data")
    total_kb = sum(_dir_size_kb(d) for d in orphans)
    if dry_run:
        return _scanned(f"would remove {len(orphans)} orphaned dirs ({human_kb(total_kb)})")
    for d in orphans:
        shutil.rmtree(d, ignore_errors=True)
    return _freed(total_kb) if total_kb > 0 else _result("freed", f"removed {len(orphans)} dirs")


def clean_flatpak_cache(dry_run):
    """Clean Flatpak cache/temp directories."""
    if not _has("flatpak"):
        return _skipped()
    home = Path.home()
    user_dirs = [
        home / ".cache" / "flatpak",
        home / ".local" / "share" / "flatpak" / "repo" / "tmp",
        home / ".local" / "share" / "flatpak" / "repo" / "cache",
    ]
    system_dirs = [
        Path("/var/lib/flatpak/repo/tmp"),
        Path("/var/lib/flatpak/repo/cache"),
    ]
    all_dirs = user_dirs + system_dirs
    total_kb = sum(_dir_size_kb(d) for d in all_dirs if d.is_dir())
    if total_kb == 0:
        return _clean("no flatpak cache")
    if dry_run:
        return _scanned(f"would clear flatpak cache ({human_kb(total_kb)})")
    for d in user_dirs:
        if d.is_dir():
            _rm_contents(d)
    for d in system_dirs:
        if d.is_dir():
            _run(["sudo", "find", str(d), "-mindepth", "1", "-maxdepth", "1",
                  "-exec", "rm", "-rf", "{}", "+"])
    after_kb = sum(_dir_size_kb(d) for d in all_dirs if d.is_dir())
    freed = max(0, total_kb - after_kb)
    return _freed(freed) if freed > 0 else _clean()


def clean_temp_files(dry_run):
    """Remove old files from /tmp and /var/tmp."""
    tmp_files = _find("/tmp", "-xdev", "-mindepth", "1", "-mtime", "+3",
                      "(", "-type", "f", "-o", "-type", "l", ")")
    var_files = _find("/var/tmp", "-xdev", "-mindepth", "1", "-mtime", "+7",
                      "(", "-type", "f", "-o", "-type", "l", ")")
    total = len(tmp_files) + len(var_files)
    if total == 0:
        return _clean("no old temp files")
    if dry_run:
        return _scanned(f"would remove {total} old temp files")
    before = _dir_size_kb("/tmp") + _dir_size_kb("/var/tmp")
    for args in [
        ["find", "/tmp", "-xdev", "-mindepth", "1", "-mtime", "+3",
         "(", "-type", "f", "-o", "-type", "l", ")", "-delete"],
        ["find", "/tmp", "-xdev", "-mindepth", "1", "-type", "d", "-empty", "-mtime", "+3", "-delete"],
        ["sudo", "find", "/var/tmp", "-xdev", "-mindepth", "1", "-mtime", "+7",
         "(", "-type", "f", "-o", "-type", "l", ")", "-delete"],
        ["sudo", "find", "/var/tmp", "-xdev", "-mindepth", "1", "-type", "d", "-empty", "-mtime", "+7", "-delete"],
    ]:
        _run(args, timeout=30)
    after = _dir_size_kb("/tmp") + _dir_size_kb("/var/tmp")
    freed = max(0, before - after)
    return _freed(freed) if freed > 0 else _clean(f"removed {total} files")


def clean_user_cache(dry_run):
    """Clean old user cache files and config backups."""
    home = Path.home()
    cache_dir = str(home / ".cache")
    config_dir = str(home / ".config")
    share_dir = str(home / ".local" / "share")

    cache_files = _find(cache_dir, "-mindepth", "1", "-type", "f", "-atime", "+30")
    bak_files = _find(config_dir, share_dir, "-type", "f",
                      "(", "-name", "*.bak", "-o", "-name", "*.old",
                      "-o", "-name", "*~", "-o", "-name", "*.swp",
                      "-o", "-name", "*.pacsave", ")")
    total = len(cache_files) + len(bak_files)
    if total == 0:
        return _clean("no old cache/backup files")
    if dry_run:
        return _scanned(f"would remove {len(cache_files)} cache + {len(bak_files)} backup files")
    if cache_files:
        _run(["find", cache_dir, "-mindepth", "1", "-type", "f", "-atime", "+30", "-delete"], timeout=60)
        _run(["find", cache_dir, "-mindepth", "1", "-type", "d", "-empty", "-delete"], timeout=30)
    if bak_files:
        _run(["find", config_dir, share_dir, "-type", "f",
              "(", "-name", "*.bak", "-o", "-name", "*.old",
              "-o", "-name", "*~", "-o", "-name", "*.swp",
              "-o", "-name", "*.pacsave", ")", "-delete"], timeout=30)
    return _result("freed", f"removed {total} files")


def clean_coredumps(dry_run):
    """Remove systemd coredumps."""
    dump_dir = Path("/var/lib/systemd/coredump")
    if not dump_dir.is_dir():
        return _clean("no coredump dir")
    try:
        files = list(dump_dir.iterdir())
    except PermissionError:
        files = _find(str(dump_dir), "-type", "f")
    if not files:
        return _clean("no coredumps")
    before = _dir_size_kb(dump_dir)
    count = len(files)
    if dry_run:
        return _scanned(f"would remove {count} coredumps ({human_kb(before)})")
    _run(["sudo", "bash", "-c", f"rm -rf {dump_dir}/*"])
    after = _dir_size_kb(dump_dir)
    freed = max(0, before - after)
    return _freed(freed) if freed > 0 else _clean(f"removed {count} coredumps")


def clean_thumbnails(dry_run):
    """Clean thumbnail cache."""
    home = Path.home()
    dirs = [home / ".cache" / "thumbnails", home / ".thumbnails"]
    total_kb = sum(_dir_size_kb(d) for d in dirs if d.is_dir())
    if total_kb == 0:
        return _clean("no thumbnail cache")
    if dry_run:
        return _scanned(f"would clear thumbnails ({human_kb(total_kb)})")
    for d in dirs:
        if d.is_dir():
            _rm_contents(d)
    return _freed(total_kb)


def clean_trash(dry_run):
    """Empty trash bin."""
    trash = Path.home() / ".local" / "share" / "Trash"
    files_dir = trash / "files"
    if not files_dir.is_dir():
        return _clean("trash is empty")
    try:
        items = list(files_dir.iterdir())
    except PermissionError:
        items = []
    if not items:
        return _clean("trash is empty")
    before = _dir_size_kb(trash)
    count = len(items)
    if dry_run:
        return _scanned(f"would empty trash ({count} items, {human_kb(before)})")
    _rm_contents(files_dir)
    _rm_contents(trash / "info")
    _rm_contents(trash / "expunged")
    return _freed(before)


def clean_broken_symlinks(dry_run):
    """Find and remove broken symlinks in home."""
    home = str(Path.home())
    all_broken = _find(home, "-maxdepth", "4", "-xtype", "l")
    exclude = ("SingletonLock", "SingletonCookie", "SingletonSocket",
               ".snap/", "/run/", "/proc/", ".steam/")
    broken = [f for f in all_broken if not any(e in f for e in exclude)]
    if not broken:
        return _clean("no broken symlinks")
    count = len(broken)
    if dry_run:
        return _scanned(f"would remove {count} broken symlinks")
    for link in broken:
        try:
            os.unlink(link)
        except OSError:
            pass
    return _result("freed", f"removed {count} broken symlinks")


def clean_crash_reports(dry_run):
    """Clean Electron/Chromium crash reports."""
    home = str(Path.home())
    crash_dirs = _find(home, "-maxdepth", "5", "-name", "Crash Reports", "-type", "d")
    crash_files = _find(home, "-maxdepth", "4",
                        "(", "-name", "*.dmp", "-o", "-name", "*.core", ")", "-type", "f")
    if not crash_dirs and not crash_files:
        return _clean("no crash reports")
    total_kb = sum(_dir_size_kb(d) for d in crash_dirs)
    if dry_run:
        return _scanned(f"would remove crash data ({human_kb(total_kb)})")
    for d in crash_dirs:
        _rm_contents(d)
    for f in crash_files:
        try:
            os.unlink(f)
        except OSError:
            pass
    return _freed(total_kb) if total_kb > 0 else _result("freed", "removed crash data")


def clean_mesa_shader(dry_run):
    """Clean Mesa/GPU shader cache."""
    home = Path.home()
    dirs = [
        home / ".cache" / "mesa_shader_cache",
        home / ".cache" / "mesa_shader_cache_db",
        home / ".cache" / "radv_builtin_shaders64",
        home / ".nv",
        home / ".cache" / "nvidia",
        home / ".cache" / "AMD",
    ]
    # Add Qt shader cache dirs
    cache_dir = home / ".cache"
    if cache_dir.is_dir():
        dirs.extend(f for f in cache_dir.iterdir()
                    if f.name.startswith("qtshader") and f.is_dir())
    existing = [d for d in dirs if d.is_dir()]
